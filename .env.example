# Copy to .env and replace placeholders. Never commit real secrets.

# PostgreSQL connection (docker-compose.yml exposes local Postgres on 5433)
DATABASE_URL="postgresql://fitgrid:fitgrid@localhost:5433/fitgrid"

# Database used by integration tests. It is reset by the test run, so never point it at real data.
TEST_DATABASE_URL="postgresql://fitgrid:fitgrid@localhost:5433/fitgrid_test"

# Better Auth: at least 32 random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32-plus-character-secret"

# Public base URL of the app (used for auth callbacks and links in emails)
BETTER_AUTH_URL="http://localhost:3000"

# Email delivery. Only "console" is implemented: emails are written to the server log.
EMAIL_TRANSPORT="console"

# Sandbox payment provider (simulated online payments; no real money moves).
# Secret used to sign and verify its webhooks. Generate with: openssl rand -base64 32
PAYMENTS_SANDBOX_WEBHOOK_SECRET="replace-with-a-random-32-plus-character-secret"
