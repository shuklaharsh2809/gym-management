// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

enum LeadStage {
  NEW
  CONTACTED
  TRIAL_BOOKED
  TRIAL_COMPLETED
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WALK_IN
  WEBSITE
  REFERRAL
  PHONE
  CAMPAIGN
  SOCIAL
  OTHER
}

model Lead {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @map("organization_id") @db.Uuid
  branchId          String     @map("branch_id") @db.Uuid
  name              String
  phone             String?
  email             String?
  source            LeadSource
  stage             LeadStage  @default(NEW)
  interest          String?
  ownerMembershipId String?    @map("owner_membership_id") @db.Uuid
  nextFollowUpAt    DateTime?  @map("next_follow_up_at") @db.Timestamptz(3)
  lostReason        String?    @map("lost_reason")
  convertedMemberId String?    @map("converted_member_id") @db.Uuid
  convertedAt       DateTime?  @map("converted_at") @db.Timestamptz(3)
  createdById       String?    @map("created_by_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch          Branch                  @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  owner           OrganizationMembership? @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  convertedMember Member?                 @relation(fields: [convertedMemberId], references: [id], onDelete: Restrict)
  activities      LeadActivity[]
  followUps       FollowUp[]

  @@unique([id, organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, nextFollowUpAt])
  @@map("leads")
}

enum LeadActivityType {
  NOTE
  CALL
  EMAIL
  MESSAGE
  VISIT
  STAGE_CHANGE
  FOLLOW_UP_DONE
  CONVERTED
}

model LeadActivity {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  leadId         String           @map("lead_id") @db.Uuid
  type           LeadActivityType
  body           String?
  fromStage      LeadStage?       @map("from_stage")
  toStage        LeadStage?       @map("to_stage")
  actorId        String?          @map("actor_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         Lead         @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
  @@map("lead_activities")
}

model FollowUp {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  leadId                 String    @map("lead_id") @db.Uuid
  dueAt                  DateTime  @map("due_at") @db.Timestamptz(3)
  note                   String?
  assignedToMembershipId String?   @map("assigned_to_membership_id") @db.Uuid
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(3)
  createdById            String?   @map("created_by_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lead         Lead                    @relation(fields: [leadId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedTo   OrganizationMembership? @relation(fields: [assignedToMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueAt])
  @@map("follow_ups")
}

// ---------------------------------------------------------------------------
// Workforce
// ---------------------------------------------------------------------------

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

/// A staff record. May or may not have a FitGrid login (membershipId).
model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  primaryBranchId    String           @map("primary_branch_id") @db.Uuid
  membershipId       String?          @unique @map("membership_id") @db.Uuid
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  email              String?
  phone              String?
  jobTitle           String           @map("job_title")
  employmentType     EmploymentType   @map("employment_type")
  status             EmploymentStatus @default(ACTIVE)
  startDate          DateTime         @map("start_date") @db.Date
  endDate            DateTime?        @map("end_date") @db.Date
  isTrainer          Boolean          @default(false) @map("is_trainer")
  specializations    String[]         @default([])
  bio                String?
  /// Sensitive: requires staff.compensation.read.
  monthlySalaryMinor Int?             @map("monthly_salary_minor")
  /// Sensitive: requires staff.compensation.read.
  commissionBps      Int?             @map("commission_bps")
  currency           String           @db.Char(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  primaryBranch    Branch                  @relation(fields: [primaryBranchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership       OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  shifts           Shift[]
  leaveRequests    LeaveRequest[]
  classSessions    ClassSession[]
  trainingSessions TrainingSession[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("employees")
}

model Shift {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  startsAt       DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(3)
  note           String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, branchId, startsAt])
  @@index([organizationId, employeeId, startsAt])
  @@map("shifts")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  employeeId     String      @map("employee_id") @db.Uuid
  type           LeaveType
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  reason         String?
  status         LeaveStatus @default(PENDING)
  decidedById    String?     @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?   @map("decided_at") @db.Timestamptz(3)
  decisionNote   String?     @map("decision_note")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Scheduling: rooms, classes, bookings, personal training
// ---------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

model Room {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  name           String
  capacity       Int
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sessions     ClassSession[]

  @@unique([id, organizationId])
  @@unique([branchId, name])
  @@map("rooms")
}

model ClassType {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  name            String
  description     String?
  durationMinutes Int          @map("duration_minutes")
  defaultCapacity Int          @map("default_capacity")
  color           String       @default("#047857")
  status          RecordStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions     ClassSession[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@map("class_types")
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

model ClassSession {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  classTypeId     String        @map("class_type_id") @db.Uuid
  roomId          String?       @map("room_id") @db.Uuid
  trainerId       String?       @map("trainer_id") @db.Uuid
  startsAt        DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime      @map("ends_at") @db.Timestamptz(3)
  capacity        Int
  status          SessionStatus @default(SCHEDULED)
  seriesId        String?       @map("series_id") @db.Uuid
  cancelledReason String?       @map("cancelled_reason")
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  classType    ClassType    @relation(fields: [classTypeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  trainer      Employee?    @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  bookings     Booking[]

  @@unique([id, organizationId])
  @@index([organizationId, branchId, startsAt])
  @@index([trainerId, startsAt])
  @@map("class_sessions")
}

enum BookingStatus {
  BOOKED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

model Booking {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  sessionId        String        @map("session_id") @db.Uuid
  memberId         String        @map("member_id") @db.Uuid
  status           BookingStatus
  waitlistPosition Int?          @map("waitlist_position")
  /// Class pack the session was paid from, if any.
  membershipId     String?       @map("membership_id") @db.Uuid
  creditConsumed   Boolean       @default(false) @map("credit_consumed")
  bookedAt         DateTime      @default(now()) @map("booked_at") @db.Timestamptz(3)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdById      String?       @map("created_by_id") @db.Uuid

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session      ClassSession   @relation(fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member       Member         @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership   GymMembership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([organizationId, sessionId, status])
  @@index([organizationId, memberId])
  @@map("bookings")
}

enum TrainingSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// One-to-one personal training appointment.
model TrainingSession {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  memberId       String                @map("member_id") @db.Uuid
  trainerId      String                @map("trainer_id") @db.Uuid
  startsAt       DateTime              @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime              @map("ends_at") @db.Timestamptz(3)
  status         TrainingSessionStatus @default(SCHEDULED)
  membershipId   String?               @map("membership_id") @db.Uuid
  creditConsumed Boolean               @default(false) @map("credit_consumed")
  notes          String?
  createdById    String?               @map("created_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  member       Member         @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)
  trainer      Employee       @relation(fields: [trainerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  membership   GymMembership? @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([organizationId, trainerId, startsAt])
  @@index([organizationId, memberId])
  @@map("training_sessions")
}

// ---------------------------------------------------------------------------
// Suppliers, equipment and maintenance
// ---------------------------------------------------------------------------

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  contactName    String?      @map("contact_name")
  email          String?
  phone          String?
  notes          String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment      Equipment[]
  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@map("suppliers")
}

enum EquipmentStatus {
  ACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

model Equipment {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  branchId       String          @map("branch_id") @db.Uuid
  assetTag       String          @map("asset_tag")
  name           String
  category       String
  brand          String?
  model          String?
  serialNumber   String?         @map("serial_number")
  purchaseDate   DateTime?       @map("purchase_date") @db.Date
  costMinor      Int?            @map("cost_minor")
  currency       String          @db.Char(3)
  supplierId     String?         @map("supplier_id") @db.Uuid
  warrantyUntil  DateTime?       @map("warranty_until") @db.Date
  location       String?
  status         EquipmentStatus @default(ACTIVE)
  retiredAt      DateTime?       @map("retired_at") @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch                 @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier     Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  schedules    MaintenanceSchedule[]
  workOrders   MaintenanceWorkOrder[]
  transfers    EquipmentTransfer[]

  @@unique([id, organizationId])
  @@unique([organizationId, assetTag])
  @@index([organizationId, branchId, status])
  @@map("equipment")
}

model MaintenanceSchedule {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  equipmentId    String    @map("equipment_id") @db.Uuid
  title          String
  intervalDays   Int       @map("interval_days")
  lastDoneOn     DateTime? @map("last_done_on") @db.Date
  nextDueOn      DateTime  @map("next_due_on") @db.Date
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment    Equipment              @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workOrders   MaintenanceWorkOrder[]

  @@unique([id, organizationId])
  @@index([organizationId, nextDueOn])
  @@map("maintenance_schedules")
}

enum WorkOrderType {
  PREVENTIVE
  CORRECTIVE
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceWorkOrder {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @map("organization_id") @db.Uuid
  equipmentId            String            @map("equipment_id") @db.Uuid
  branchId               String            @map("branch_id") @db.Uuid
  scheduleId             String?           @map("schedule_id") @db.Uuid
  type                   WorkOrderType
  priority               WorkOrderPriority @default(MEDIUM)
  status                 WorkOrderStatus   @default(OPEN)
  title                  String
  description            String?
  /// Whether the fault took the equipment out of use (for downtime reporting).
  takesOutOfService      Boolean           @default(false) @map("takes_out_of_service")
  assignedToMembershipId String?           @map("assigned_to_membership_id") @db.Uuid
  reportedById           String?           @map("reported_by_id") @db.Uuid
  openedAt               DateTime          @default(now()) @map("opened_at") @db.Timestamptz(3)
  startedAt              DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?         @map("completed_at") @db.Timestamptz(3)
  resolution             String?
  costMinor              Int               @default(0) @map("cost_minor")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment    Equipment               @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch       Branch                  @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  schedule     MaintenanceSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  assignedTo   OrganizationMembership? @relation(fields: [assignedToMembershipId], references: [id], onDelete: SetNull)
  expenses     Expense[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, equipmentId])
  @@map("maintenance_work_orders")
}

model EquipmentTransfer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  equipmentId    String   @map("equipment_id") @db.Uuid
  fromBranchId   String   @map("from_branch_id") @db.Uuid
  toBranchId     String   @map("to_branch_id") @db.Uuid
  note           String?
  actorId        String?  @map("actor_id") @db.Uuid
  transferredAt  DateTime @default(now()) @map("transferred_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  equipment    Equipment    @relation(fields: [equipmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  fromBranch   Branch       @relation("TransferFrom", fields: [fromBranchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  toBranch     Branch       @relation("TransferTo", fields: [toBranchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, equipmentId])
  @@map("equipment_transfers")
}

// ---------------------------------------------------------------------------
// Inventory and purchasing
// ---------------------------------------------------------------------------

model Product {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  sku               String
  name              String
  category          String?
  barcode           String?
  priceMinor        Int          @map("price_minor")
  costMinor         Int          @default(0) @map("cost_minor")
  currency          String       @db.Char(3)
  taxRateBps        Int          @default(0) @map("tax_rate_bps")
  taxInclusive      Boolean      @default(true) @map("tax_inclusive")
  lowStockThreshold Int          @default(0) @map("low_stock_threshold")
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stock              ProductStock[]
  movements          StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       InvoiceLine[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@map("products")
}

/// Current on-hand quantity per branch. Always changed together with a StockMovement row.
model ProductStock {
  productId      String @map("product_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  branchId       String @map("branch_id") @db.Uuid
  quantity       Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([productId, branchId])
  @@map("product_stock")
}

enum StockMovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
}

/// Append-only ledger of stock changes. quantity is signed (+ in, − out).
model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  branchId        String            @map("branch_id") @db.Uuid
  type            StockMovementType
  quantity        Int
  reason          String?
  purchaseOrderId String?           @map("purchase_order_id") @db.Uuid
  invoiceId       String?           @map("invoice_id") @db.Uuid
  transferGroupId String?           @map("transfer_group_id") @db.Uuid
  actorId         String?           @map("actor_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId, productId, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@map("stock_movements")
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  number         String
  supplierId     String              @map("supplier_id") @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @db.Char(3)
  totalCostMinor Int                 @map("total_cost_minor")
  notes          String?
  orderedAt      DateTime?           @map("ordered_at") @db.Timestamptz(3)
  receivedAt     DateTime?           @map("received_at") @db.Timestamptz(3)
  createdById    String?             @map("created_by_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines        PurchaseOrderLine[]
  movements    StockMovement[]
  expenses     Expense[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  productId       String @map("product_id") @db.Uuid
  quantity        Int
  unitCostMinor   Int    @map("unit_cost_minor")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product       Product       @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MAINTENANCE
  EQUIPMENT
  SUPPLIES
  MARKETING
  OTHER
}

model Expense {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  branchId        String          @map("branch_id") @db.Uuid
  category        ExpenseCategory
  description     String
  amountMinor     Int             @map("amount_minor")
  currency        String          @db.Char(3)
  incurredOn      DateTime        @map("incurred_on") @db.Date
  paymentMethod   PaymentMethod   @map("payment_method")
  reference       String?
  supplierId      String?         @map("supplier_id") @db.Uuid
  workOrderId     String?         @map("work_order_id") @db.Uuid
  purchaseOrderId String?         @map("purchase_order_id") @db.Uuid
  voidedAt        DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidReason      String?         @map("void_reason")
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch        Branch                @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier      Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  workOrder     MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([organizationId, branchId, incurredOn])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Background jobs, notifications and integrations
// ---------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  DEAD
}

/// Durable job queue (Postgres, SKIP LOCKED). Retries with exponential backoff.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  type           String
  payload        Json
  organizationId String?   @map("organization_id") @db.Uuid
  status         JobStatus @default(PENDING)
  runAt          DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  lastError      String?   @map("last_error")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  /// Prevents enqueuing the same logical job twice (e.g. one daily run per organization per day).
  idempotencyKey String?   @unique @map("idempotency_key")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, runAt])
  @@map("jobs")
}

/// In-app notification for a team member.
model Notification {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  recipientMembershipId String    @map("recipient_membership_id") @db.Uuid
  type                  String
  title                 String
  body                  String?
  link                  String?
  readAt                DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient    OrganizationMembership @relation(fields: [recipientMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([recipientMembershipId, readAt, createdAt])
  @@map("notifications")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Log of outgoing emails (one row per message).
model EmailDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  recipient      String
  subject        String
  template       String
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error")
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("email_deliveries")
}

/// Organization-configured outbound webhook. Payloads are signed with `secret`.
model WebhookEndpoint {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  url            String
  description    String?
  secret         String
  events         String[]
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries   WebhookDelivery[]

  @@unique([id, organizationId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  endpointId     String         @map("endpoint_id") @db.Uuid
  eventId        String         @map("event_id") @db.Uuid
  eventType      String         @map("event_type")
  payload        Json
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  responseStatus Int?           @map("response_status")
  lastError      String?        @map("last_error")
  deliveredAt    DateTime?      @map("delivered_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  endpoint     WebhookEndpoint @relation(fields: [endpointId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

enum ImportStatus {
  PREVIEWED
  COMPLETED
}

/// Record of a CSV import for traceability.
model ImportRun {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           String
  fileName       String?      @map("file_name")
  status         ImportStatus
  totalRows      Int          @map("total_rows")
  createdRows    Int          @default(0) @map("created_rows")
  skippedRows    Int          @default(0) @map("skipped_rows")
  errors         Json?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@map("import_runs")
}

// ---------------------------------------------------------------------------
// SaaS plans and subscriptions (FitGrid's own billing of organizations)
// ---------------------------------------------------------------------------

model PlatformPlan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  /// null = unlimited
  maxBranches       Int?     @map("max_branches")
  maxMembers        Int?     @map("max_members")
  features          String[] @default([])
  priceMinorMonthly Int      @map("price_minor_monthly")
  currency          String   @db.Char(3)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscriptions OrganizationSubscription[]

  @@map("platform_plans")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

model OrganizationSubscription {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @unique @map("organization_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan         PlatformPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("organization_subscriptions")
}

// ---------------------------------------------------------------------------
// Member documents (waivers, consent, ID) and public contact requests
// ---------------------------------------------------------------------------

enum DocumentKind {
  WAIVER
  CONSENT
  ID_PROOF
  MEDICAL
  OTHER
}

/// Files are stored in Postgres (small documents only) so tenant isolation and backups cover them.
model MemberDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  memberId       String       @map("member_id") @db.Uuid
  kind           DocumentKind
  title          String
  fileName       String       @map("file_name")
  contentType    String       @map("content_type")
  sizeBytes      Int          @map("size_bytes")
  sha256         String
  content        Bytes
  /// MEDICAL documents and anything marked sensitive require members.sensitive.read.
  sensitive      Boolean      @default(false)
  /// For waivers/consent: when the member signed or agreed.
  signedAt       DateTime?    @map("signed_at") @db.Timestamptz(3)
  uploadedById   String?      @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       Member       @relation(fields: [memberId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, memberId])
  @@map("member_documents")
}

/// Enquiries from the public contact form (not tenant data).
model ContactRequest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  company   String?
  locations Int?
  message   String
  ipHash    String?  @map("ip_hash")
  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("contact_requests")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only. organizationId is null only for platform-level events.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
